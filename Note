"""
@staticmethod
def check_stability(debit: float, pression: float, inertie: float,
pi_micro: float, threshold: float = 1e6) -> Tuple[bool, float]:
"""
Vérifie la stabilité du système.
Args:
debit: Taux de flux
pression: Pression appliquée
inertie: Résistance à l'accélération
pi_micro: Micro-pression critique
threshold: Seuil d'explosion
Returns:
(est_stable, valeur_calculée)
"""
Y_infinity = debit + (pression * inertie)
est_stable = abs(Y_infinity - pi_micro) < threshold and Y_infinity > 0
return est_stable, Y_infinity
