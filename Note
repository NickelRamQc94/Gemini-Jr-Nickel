def markov_stationnaire(M, iters=500):
    v = np.ones(M.shape[0]) / M.shape[0]
    for _ in range(iters): v = v @ M
    return v / v.sum()

def bayes_odds(prior, lr):
    post = (prior/(1-prior)) * lr
    return post / (1 + post)

def montecarlopi(n=200000, seed=94):
    rng = np.random.default_rng(seed)
    pts = rng.uniform(-1, 1, size=(n, 2))
    return 4.0  ((pts*2).sum(axis=1) = 20: out[i-20] = p
    return out

def boxcountingdimension(pts, epsilons):
    counts = []
    for eps in epsilons:
        ix = np.floor(pts[:,0]/eps).astype(int); iy = np.floor(pts[:,1]/eps).astype(int)
        counts.append(len(set(zip(ix.tolist(), iy.tolist()))))
    x = np.log(1/np.asarray(epsilons, float)); y = np.log(np.asarray(counts, float))
    return float(np.polyfit(x, y, 1)[0])

── MODULE 4 : GÉOMÉTRIE & ANGLES (Poincaré corrigé BUG-N1, Gauss-Bonnet) ─
def poincare_curvature(x, y):                        # THM: K ≡ -1 identiquement
    r2 = xx + yy
    if r2 >= 1.0: return float('nan')
    lam = 2.0/(1.0-r2); lap = 4.0/(1.0-r2)2
    return -lap/lam2

def poincare_distance(p, q):
    p = np.asarray(p, float); q = np.asarray(q, float)
    dp, dq = (pp).sum(), (qq).sum()
    if dp >= 1 or dq >= 1: raise ValueError("hors disque")
    arg = 1 + 2((p-q)2).sum()/((1-dp)(1-dq))
    return float(np.arccosh(max(arg, 1.0)))

def triangle_hyperbolique(area): return math.pi - area, (math.pi - area)/3.0
def triangle_spherique(area, R=1.0): return math.pi + area/(R*R)

