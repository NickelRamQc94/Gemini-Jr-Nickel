def arrhenius(A, Ea, T):
    expo = Ea/(R_GAS*T)          # analyse dimensionnelle: sans dimension ✓
    return A*math.exp(-expo), expo
def michaelis_menten(Vmax, Km, S): return Vmax*S/(Km+S)
def reticulation(t, k, E): return 1.0 - math.exp(-kEt)

