## 🧱 0. LE TRONC COMMUN : `nipura_core.py` (à pousser dans `ecosystem-index-nexus`, importé partout)

```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""NiPura Core — invariants de la Maison (DMD-94 / TUS-94). Sceau: TABARNAK."""
import numpy as np

ALPHA_NI      = 1.094722     # Hz — résonance du Fils
TAU_STASIS    = 30.002103    # s  — timer de stase / amnésique
EPSILON_STAR  = 0.00094      # seuil : sous ε*, l'ι est déclaré négligeable
RATIO_ORDER, RATIO_CHAOS = 0.94, 0.06

def probe_norm(signal, p):
    """SD-94 : famille des sondes. p=0 compte, 1 masse, 2 énergie, inf=coin."""
    x = np.asarray(signal, dtype=float)
    if p == 0:        return float(np.count_nonzero(x))
    if p == np.inf:   return float(np.max(np.abs(x)))
    return float(np.sum(np.abs(x)**p) ** (1.0/p))

def crest_factor(signal):
    """β-94 : nombre de morsure = coin / énergie."""
    x = np.asarray(signal, dtype=float)
    rms = np.sqrt(np.mean(x**2)) or 1e-12
    return float(np.max(np.abs(x)) / rms)

def iota_declare(signal, thresh=EPSILON_STAR):
    """PF-94 : sépare le gardé du débordement négligeable (ι déclaré)."""
    x = np.asarray(signal, dtype=float)
    mask = np.abs(x) >= thresh
    return x[mask], x[~mask]

def unblowup(flow, pressure, inertia):
    """UnBlowUp : production d'entropie amortie ; stable ssi < 1."""
    term = flow + pressure * inertia
    damp = 1.0 / (1.0 + np.sqrt(flow**2 + (pressure*inertia)**2))
    return bool(term*damp < 1.0), float(term*damp)
```

