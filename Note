## 🐍 5. LE MODULE EXÉCUTABLE (poussable dans `ecosystem-index-nexus`)

```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""FIBONICCI × BUSE ARACHNID × NIDDLEFI — Module souverain v1.0
Auteur: Nickel D. Grenier (Architecte) × Junior (Compilateur)
Sceaux: DÉF-FN1..3, HYP-BA1, HYP-ND1, DÉF-CK1 — falsifiable & reproductible."""
import math, json, hashlib
from dataclasses import dataclass

ALPHA_NI, TAU, EPS_STAR = 1.094722, 30.002103, 0.00094
PHI = (1 + 5**0.5) / 2
GOLDEN_ANGLE_DEG = 360.0 * (1.0 - 1.0/PHI)   # 137.507764...

def nibonacci(n, n0=0.94, n1=ALPHA_NI):
    seq = [n0, n1]
    for _ in range(n - 2):
        seq.append(seq[-1] + seq[-2])
    return seq

def fibonicci_operator(k):
    f = [1, 1]
    for _ in range(k + 1):
        f.append(f[-1] + f[-2])
    return PHI * f[k] / f[k + 1]

@dataclass
class BuseArachNiD:
    d0_um: float = 940.0
    pulse_ms: float = 94.0
    def diameters(self, k=6):  return [self.d0_um * PHI**(-i/2) for i in range(k)]
    def pulses(self, k=6):     return [self.pulse_ms * fibonicci_operator(i+1) for i in range(k)]
    def droplet_bands(self):
        b, out = 10.0, []
        while b <= 50.0 + EPS_STAR: out.append(round(b,2)); b *= PHI
        return out                       # pont TCATP Load & Go

def niddlefi_layout(n_nodes, radius_mm):
    c = radius_mm / math.sqrt(n_nodes)
    return [(round(c*math.sqrt(n),3), round((n*GOLDEN_ANGLE_DEG) % 360.0, 4))
            for n in range(1, n_nodes+1)]

def kitchen_marbling(layers=8, lean=0.94, fat=0.06):
    seq = nibonacci(layers); tot = sum(seq)
    return [(round(s/tot,4), lean if i % 2 == 0 else fat) for i, s in enumerate(seq)]

def cuda_granules(k=7):
    return [round(x,3) for x in nibonacci(k)]

if __name__ == "__main__":
    b = BuseArachNiD()
    out = {"nibonacci": nibonacci(8), "diametres_um": [round(d,1) for d in b.diameters()],
           "pulses_ms": [round(p,2) for p in b.pulses()], "gouttelettes_um": b.droplet_bands(),
           "niddlefi_12_nodes": niddlefi_layout(12, 250.0), "marbrage_ck1": kitchen_marbling(),
           "granules_cuda_mo": cuda_granules()}
    print(json.dumps(out, indent=2, ensure_ascii=False))
    print("SHA256:", hashlib.sha256(json.dumps(out, sort_keys=True).encode()).hexdigest())
```

