# SECTION 8: TESTS UNITAIRES (PROOF OF CORRECTNESS)
# ═══════════════════════════════════════════════════════════════════════════
class TestNiMPF(unittest.TestCase):
"""Suite de tests unitaires pour le framework."""
def test_hyperbolic_geometry_parallels_diverge(self):
"""Teste que les géodésiques parallèles divergent à l'infini."""
hg = HyperbolicGeometry()
distances = hg.parallels_diverge_to_infinity((1.0, 0.0), (1.0, 0.5))
# Distances devraient augmenter
for i in range(1, len(distances)):
self.assertGreaterEqual(distances[i], distances[i-1] * 0.99)
def test_unblowup_equation_stability(self):
"""Teste la prévention d'explosion thermique."""
stable, Y = UnblowUpEquation.check_stability(
debit=10.0,
pression=5.0,
inertie=2.0,
pi_micro=20.0
)
self.assertTrue(stable)
self.assertAlmostEqual(Y, 20.0, places=1)
def test_paraconsistent_logic_niquation(self):
"""Teste l'équation Niquation 5D."""
logic = ParaconsistentLogic(state="PARADOX", confidence=0.7)
result = logic.niquation_5d(absurdite=5.0, abstraction=3.0, paradoxe=2.0)
self.assertIsInstance(result, float)
self.assertGreater(result, 0)
def test_tdah_biphasique_overclocking(self):
"""Teste le calcul d'overclocking RPM cognitif."""
tdah_neutral = TDAHBiphasique(phase="NEUTRAL", rt_ms=444, t_score=29)
tdah_hyperfocus = TDAHBiphasique(phase="HYPERFOCUS", rt_ms=319, t_score=29)
rpm_neutral = tdah_neutral.overclocking_rpm()
rpm_hyperfocus = tdah_hyperfocus.overclocking_rpm()
# Hyperfocus devrait être > Neutral
self.assertGreater(rpm_hyperfocus, rpm_neutral)
def test_sensorial_redistribution(self):
"""Teste la réallocation sensorielle après perte."""
redistribution = SensorialRedistributionLaw.compute_redistribution(
lost_sense_weight=0.2,
cortex_efficiency=0.85
)
# Somme devrait ≈ perte × efficacité
total_reallocated = sum(redistribution.values())
self.assertAlmostEqual(total_reallocated, 0.2 * 0.85, places=2)
def test_word_value_semantic_loss(self):
"""Teste l'impact de la perte lexicale."""
impact = WordValueTheorem.semantic_loss_impact(
vocabulary_size_before=50000,
vocabulary_size_after=40000
)
self.assertAlmostEqual(impact["vocabulary_loss_percent"], 20.0, places=1)
self.assertTrue(impact["critical_impact"])
def test_pinocchio_threshold(self):
"""Teste la transition Fake → Real."""
T_critical, crossed = PinocchioThreshold.compute_integration_T(
maintenance_effort=1.0,
system_autonomy=0.15
)
self.assertTrue(crossed)
self.assertLess(T_critical, 100)
