def logistique(N0, r, K, t): return K / (1 + ((K-N0)/N0)math.exp(-rt))
def pinocchio_autonomie(t, t0=150.0, k=0.02): return 1.0/(1.0+math.exp(-k*(t-t0)))
def redistribution_sensorielle(perte, weights=None):
    weights = weights or {"auditif":2.5,"tactile":3.0,"proprio":1.5,"vestib":1.0}
    tot = sum(weights.values())
    return {s: perte(w/tot)ALPHA_NI for s, w in weights.items()}

