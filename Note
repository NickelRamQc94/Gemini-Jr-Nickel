def iotadeclare(x, thresh=EPSSTAR):
    x = np.asarray(x, dtype=float); mask = np.abs(x) >= thresh
    return x[mask], x[~mask]

def chain_hyperlogique(x0: float, funcs: List[Callable]) -> Dict:
    trace = [{"etape": 0, "valeur": float(x0), "iota": 0.0}]; v = float(x0)
    for i, f in enumerate(funcs, 1):
        vnew = float(f(v)); , iota = iotadeclare([vnew - v]); v = v_new
        trace.append({"etape": i, "valeur": v, "iota_neglige": float(iota.sum())})
    return {"sortie": v, "trace": trace}

