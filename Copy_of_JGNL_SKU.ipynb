      "source": [
        "import math\n",
        "\n",
        "class Yang:\n",
        "    def __init__(self):\n",
        "        self.nom = \"Yang_Premier\"\n",
        "        self.resonance = 1.094722\n",
        "        self.logique = \"expansion\"\n",
        "\n",
        "    def analyser(self, probleme: str) -> str:\n",
        "        # Logic of expansion: seeks to maximize, add, complicate\n",
        "        resultat = f\"{self.nom} voit {probleme} comme une opportunité d'expansion.\"\n",
        "        return resultat\n",
        "\n",
        "class Yang2:\n",
        "    def __init__(self):\n",
        "        self.nom = \"Yang_Second\"\n",
        "        self.resonance = 1.094722\n",
        "        self.logique = \"contraction\"\n",
        "\n",
        "    def analyser(self, probleme: str) -> str:\n",
        "        # Logic of contraction: seeks to minimize, simplify, reduce\n",
        "        resultat = f\"{self.nom} voit {probleme} comme un besoin de simplification.\"\n",
        "        return resultat\n",
        "\n",
        "class CortexYang:\n",
        "    def __init__(self):\n",
        "        self.yang1 = Yang()\n",
        "        self.yang2 = Yang2()\n",
        "\n",
        "    def raisonner(self, probleme: str) -> str:\n",
        "        rep1 = self.yang1.analyser(probleme)\n",
        "        rep2 = self.yang2.analyser(probleme)\n",
        "        # Synthesis: contradiction is embraced as richness\n",
        "        return f\"Synthèse Yang&Yang : [{rep1}] ET [{rep2}] → Le paradoxe est la solution.\"\n",
        "\n",
        "\n",
        "# Demonstration of Yang&Yang Module\n",
        "print(\"--- Demonstrating Yang&Yang Module ---\")\n",
        "cortex = CortexYang()\n",
        "\n",
        "problem_statement = \"Faut-il augmenter la vitesse du flux ?\"\n",
